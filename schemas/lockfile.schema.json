{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skillbox.dev/v1alpha1/lockfile",
  "title": "Skillbox lockfile",
  "description": "A Skillbox lockfile (.skillbox/skillbox.lock). Generated from the Zod schemas; do not edit by hand.",
  "type": "object",
  "properties": {
    "lockfileVersion": {
      "type": "number",
      "const": 1
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema0"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prompt",
              "skill",
              "agent",
              "script",
              "api",
              "workflow",
              "component"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "local"
              },
              "path": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "type",
              "path"
            ],
            "additionalProperties": false
          },
          "integrity": {
            "$ref": "#/$defs/__schema2"
          },
          "target": {
            "$ref": "#/$defs/__schema1"
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/__schema1"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "requestedBy": {
            "anyOf": [
              {
                "type": "string",
                "const": "direct"
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ]
          }
        },
        "required": [
          "version",
          "kind",
          "source",
          "integrity",
          "target",
          "files",
          "requestedBy"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lockfileVersion",
    "resources"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
    }
  }
}
