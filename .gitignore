# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest-reports/
*.lcov

# Environment files. Excluded categorically so a real credential cannot be
# committed by accident; .env.example is the only permitted exception.
.env
.env.*
!.env.example

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Temporary
tmp/
temp/
*.tmp
